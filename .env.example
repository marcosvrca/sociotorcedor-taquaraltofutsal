# Database (Postgres — no Railway use a variável do plugin Postgres)
DATABASE_URL="postgresql://socio:socio@localhost:5433/sociotorcedor?schema=public"

# Auth (obrigatório em produção: secret forte + URL HTTPS pública)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-in-production-use-openssl-rand-base64-32"

# Uploads (Railway: monte Volume em /data e use o padrão do Dockerfile)
# UPLOAD_DIR=/data/uploads

PAYMENT_PROVIDER="PIX_MANUAL"

# Seed (opcional após migrate) — senha admin obrigatória
# ADMIN_EMAIL=admin@taquaraltofutsal.com.br
# ADMIN_PASSWORD=sua-senha-forte
# DEMO_MEMBER_PASSWORD=socio123
# FORCE_SEED=true

# Mercado Pago (opcional)
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
# MP_USE_SANDBOX=true
